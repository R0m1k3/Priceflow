# Copiez ce fichier en .env et remplacez les valeurs.
# Générer une valeur aléatoire : openssl rand -hex 32

# Mot de passe PostgreSQL (obligatoire).
# Installation existante : la base a été initialisée avec "priceflow" ; soit vous
# gardez cette valeur ici, soit vous changez d'abord le mot de passe dans la base :
#   docker exec -it priceflow-db psql -U priceflow -c "ALTER USER priceflow PASSWORD 'nouveau_mot_de_passe';"
POSTGRES_PASSWORD=change-me

# Token d'accès à Browserless (obligatoire)
BROWSERLESS_TOKEN=change-me

# Clé API OpenRouter (optionnelle, peut aussi être configurée dans l'interface admin)
OPENROUTER_API_KEY=

# Mot de passe du compte "admin" créé au tout premier démarrage (optionnel).
# Si vide, un mot de passe aléatoire est généré et affiché une fois dans les logs.
ADMIN_PASSWORD=

# Origines CORS autorisées, séparées par des virgules (vide = même origine uniquement)
CORS_ORIGINS=
